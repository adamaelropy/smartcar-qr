generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id       Int       @id @default(autoincrement())
  name          String    @db.VarChar(100)
  username      String    @unique @db.VarChar(50)
  age           Int
  phone         String    @db.VarChar(20)
  email         String    @unique @db.VarChar(100)
  password_hash String    @db.VarChar(255)
  created_at    DateTime  @default(now())

  vehicle           Vehicle?
  emergencyContacts EmergencyContact[]
  passwordResets    PasswordReset[]
  conversationsA    Conversation[]        @relation("ConversationParticipantA")
  conversationsB    Conversation[]        @relation("ConversationParticipantB")
  sentMessages      ConversationMessage[] @relation("ConversationMessageSender")
  receivedMessages  ConversationMessage[] @relation("ConversationMessageRecipient")
}

model Vehicle {
  vehicle_id   Int    @id @default(autoincrement())
  user_id      Int    @unique
  plate_number String @unique @db.VarChar(20)
  car_name     String @db.VarChar(100)
  year_model   Int
  qr_token     String @unique @db.VarChar(100)

  user           User            @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  communications Communication[]
}

model EmergencyContact {
  contact_id     Int    @id @default(autoincrement())
  user_id        Int
  relative_name  String @db.VarChar(100)
  relative_phone String @db.VarChar(20)
  relationship   String? @db.VarChar(100)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
}

model Service {
  service_id   Int      @id @default(autoincrement())
  service_name String   @db.VarChar(100)
  service_type ServiceType
  location     String   @db.VarChar(255)
  availability Boolean  @default(true)
}

model Communication {
  communication_id BigInt           @id
  vehicle_id       Int
  type             CommunicationType
  direction        CommunicationDirection
  source           String?          @db.VarChar(255)
  message          String?
  read             Boolean          @default(false)
  created_at       DateTime         @default(now())

  vehicle Vehicle @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade, onUpdate: Cascade)
}

model Conversation {
  conversation_id   BigInt                @id
  participant_a_id  Int
  participant_b_id  Int
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt
  last_message_at   DateTime              @default(now())
  participantA      User                  @relation("ConversationParticipantA", fields: [participant_a_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  participantB      User                  @relation("ConversationParticipantB", fields: [participant_b_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  messages          ConversationMessage[]

  @@unique([participant_a_id, participant_b_id])
  @@index([participant_a_id])
  @@index([participant_b_id])
  @@index([last_message_at])
}

model ConversationMessage {
  message_id       BigInt       @id
  conversation_id  BigInt
  sender_id        Int
  recipient_id     Int
  body             String       @db.Text
  kind             MessageKind  @default(TEXT)
  read_at          DateTime?
  created_at       DateTime     @default(now())
  conversation     Conversation @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade, onUpdate: Cascade)
  sender           User         @relation("ConversationMessageSender", fields: [sender_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  recipient        User         @relation("ConversationMessageRecipient", fields: [recipient_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([conversation_id, created_at])
  @@index([recipient_id, read_at])
  @@index([sender_id, created_at])
}

model PasswordReset {
  reset_id   Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique @db.VarChar(255)
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
}

enum ServiceType {
  TYRE_CHANGE
  OIL_CHANGE
  CAR_WASH
  TOW_SERVICE
  BATTERY_REPLACEMENT
  BRAKE_SERVICE
  ENGINE_DIAGNOSTICS
  AC_SERVICE
  CAR_DETAILING
  WHEEL_ALIGNMENT
  WHEEL_BALANCING
  WINDSHIELD_REPAIR
  GLASS_REPLACEMENT
  ENGINE_REPAIR
  TRANSMISSION_SERVICE
  SUSPENSION_REPAIR
  CAR_ELECTRICAL
  INSPECTION_SERVICE
  CAR_POLISHING
  FUEL_DELIVERY
}

enum CommunicationType {
  MESSAGE
  CALL
}

enum CommunicationDirection {
  SENT
  RECEIVED
}

enum MessageKind {
  TEXT
  EMERGENCY
}